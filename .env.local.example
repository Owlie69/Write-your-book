# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Stripe Price IDs
NEXT_PUBLIC_STRIPE_CLOUD_PRICE_ID=your-cloud-plan-price-id
NEXT_PUBLIC_STRIPE_DESKTOP_PRICE_ID=your-desktop-plan-price-id

# Email (Resend — resend.com)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=JustWrite <noreply@yourdomain.com>

# Cron secret (protect the /api/reminder/send endpoint)
CRON_SECRET=your-random-secret-string

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
